{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kosmotic.org/schemas/capacidad.schema.json",
  "title":"Colección de capacidades KosmoTIC",
  "type":"object",
  "required":["referencia","version","estado","fecha","capacidades"],
  "properties":{
    "referencia":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "estado":{"type":"string","minLength":1},
    "fecha":{"type":"string","format":"date"},
    "capacidades":{"type":"array","minItems":1,"items":{"type":"object","required":["id","slug","titulo","resumen","principio"],"properties":{"id":{"type":"integer","minimum":1},"slug":{"type":"string","pattern":"^[a-z0-9-]+$"},"titulo":{"type":"string","minLength":1},"resumen":{"type":"string","minLength":1},"principio":{"type":"string","minLength":1}},"additionalProperties":false}}
  },
  "additionalProperties":false
}